<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="20dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/DialogTitle"
        android:text="Connection Details" />

    <TextView style="@style/FieldLabel" android:text="DESKTOP NAME" />
    <TextView android:id="@+id/detail_desktop_name" style="@style/DetailValue" />

    <TextView style="@style/FieldLabel" android:text="RESOLUTION" />
    <TextView android:id="@+id/detail_resolution" style="@style/DetailValue" />

    <TextView style="@style/FieldLabel" android:text="COLOR DEPTH" />
    <TextView android:id="@+id/detail_color_depth" style="@style/DetailValue" />

</LinearLayout>
