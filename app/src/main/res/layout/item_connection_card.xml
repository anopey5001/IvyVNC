<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp"
    android:background="@drawable/ripple_card"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/thumb_wrap"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="14dp">

        <!-- Colored initial avatar - always present, its background
             color is computed per-connection-name at runtime. -->
        <TextView
            android:id="@+id/thumb_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="20sp" />

        <!-- Last-seen remote-screen snapshot, shown instead of the
             initial avatar once a session has actually run once.
             centerInside (not centerCrop) so the whole screenshot is
             visible, scaled down - cropping a wide desktop capture
             into a tiny square just showed an unrecognizable sliver. -->
        <ImageView
            android:id="@+id/thumb_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/card_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/card_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/card_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&#9881;"
        android:textColor="@color/text_dim"
        android:textSize="19sp"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/ripple_flat" />

</LinearLayout>
