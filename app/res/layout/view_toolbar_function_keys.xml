<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_f1" style="@style/ToolbarKey" android:text="F1" />
        <TextView android:id="@+id/key_f2" style="@style/ToolbarKey" android:text="F2" />
        <TextView android:id="@+id/key_f3" style="@style/ToolbarKey" android:text="F3" />
        <TextView android:id="@+id/key_f4" style="@style/ToolbarKey" android:text="F4" />
        <TextView android:id="@+id/key_f5" style="@style/ToolbarKey" android:text="F5" />
        <TextView android:id="@+id/key_f6" style="@style/ToolbarKey" android:text="F6" />
        <TextView android:id="@+id/key_f7" style="@style/ToolbarKey" android:text="F7" />
        <TextView android:id="@+id/key_f8" style="@style/ToolbarKey" android:text="F8" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_f9" style="@style/ToolbarKey" android:text="F9" />
        <TextView android:id="@+id/key_f10" style="@style/ToolbarKey" android:text="F10" />
        <TextView android:id="@+id/key_f11" style="@style/ToolbarKey" android:text="F11" />
        <TextView android:id="@+id/key_f12" style="@style/ToolbarKey" android:text="F12" />
        <TextView android:id="@+id/key_tilde" style="@style/ToolbarKey" android:text="~" />
        <TextView android:id="@+id/key_slash" style="@style/ToolbarKey" android:text="/" />
        <TextView android:id="@+id/key_backslash" style="@style/ToolbarKey" android:text="\\" />
        <TextView android:id="@+id/key_power" style="@style/ToolbarKey" android:text="&#9211;" />
    </LinearLayout>

</LinearLayout>
