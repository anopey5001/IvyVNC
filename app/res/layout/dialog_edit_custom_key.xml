<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="20dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/DialogTitle"
        android:text="Custom Key" />

    <TextView style="@style/FieldLabel" android:text="BUTTON LABEL" />
    <EditText
        android:id="@+id/key_label"
        style="@style/FieldInput" />

    <TextView style="@style/FieldLabel" android:text="TEXT TO SEND" />
    <EditText
        android:id="@+id/key_text"
        style="@style/FieldInput" />

    <TextView style="@style/FieldLabel" android:text="KEYSYM (HEX, OPTIONAL)" />
    <EditText
        android:id="@+id/key_keysym"
        style="@style/FieldInput"
        android:hint="ff08" />

    <TextView
        style="@style/FieldDescription"
        android:text="Overrides the text above with a single raw X11 keysym, in hex -- e.g. ff08 is Backspace, ffbe is F1." />

</LinearLayout>
